<?xml version="1.0" encoding="UTF-8"?>

<?xml-stylesheet href="https://moise-lang.github.io/xml/os.xsl" type="text/xsl" ?>

<organisational-specification
    id="mining_teams"
    os-version="1.1"

    xmlns="http://moise.sourceforge.net/os"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://moise.sourceforge.net/os
                        https://moise-lang.github.io/xml/os.xsd">

<structural-specification>

    <role-definitions>
        <role id="explorer"/>
        <role id="retriever1"/>
        <role id="retriever2"/>
    </role-definitions>

    <group-specification id="mining_team">
        <roles>
            <role id="explorer" min="1" max="1"/>
            <role id="retriever1" min="1" max="1"/>
            <role id="retriever2" min="1" max="1"/>
        </roles>

        <links>
            <link from="explorer" to="retriever1" type="communication" scope="intra-group" bi-dir="true"/>
            <link from="explorer" to="retriever2" type="communication" scope="intra-group" bi-dir="true"/>
            <link from="retriever1" to="retriever2" type="communication" scope="intra-group" bi-dir="true"/>
        </links>

        <formation-constraints>
            <compatibility from="explorer" to="retriever1"/>
            <compatibility from="explorer" to="retriever2"/>
            <compatibility from="retriever1" to="retriever2"/>
        </formation-constraints>
    </group-specification>

</structural-specification>

<functional-specification>
    <scheme id="mine_resources">
        <goal id="collect_resources">
            <plan operator="parallel">
                <goal id="scout_map" ds="Explore the map, perceive ores, and share locations by radio."/>
                <goal id="retrieve_ores" ds="Collect known ores and carry them to the depot."/>
            </plan>
        </goal>

        <mission id="scouting" min="1" max="2">
            <goal id="scout_map"/>
        </mission>

        <mission id="retrieving" min="1" max="3">
            <goal id="retrieve_ores"/>
        </mission>
    </scheme>
</functional-specification>

<normative-specification>
    <!-- Keep this example lightweight: roles are adopted in gold_miners.jcm,
         but no mission obligation is forced into the agents' intention stack. -->
</normative-specification>

</organisational-specification>
